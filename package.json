{
  "name": "image-uploader",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "chokidar-cli": "^3.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "scripts": {
    "dev": "bun --silent watch",
    "watch:temp": "bun build.ts --define.process.env.NODE_ENV=development",
    "watch": "bun --silent watch:temp & chokidar 'src/**/*.*' -c 'clear && bun --silent watch:temp'",
    "build": "bun build.ts --sourcemap=none",
    "typecheck": "bun check",
    "format": "bun fmt",
    "lint": "eslint",
    "ui": "shadcn add"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tailwindcss": "^4.3.5",
    "tar-stream": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  }
}
